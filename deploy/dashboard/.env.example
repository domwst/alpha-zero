DASHBOARD_SSH_HOST=gpu-pod.example
DASHBOARD_SSH_PORT=22
DASHBOARD_SSH_USER=root
DASHBOARD_SSH_KEY=/absolute/path/to/ssh/private-key
DASHBOARD_KNOWN_HOSTS=/absolute/path/to/verified/known_hosts
# Match the owner of the private key (id -u / id -g).
DASHBOARD_UID=1000
DASHBOARD_GID=1000
DASHBOARD_LOCAL_PORT=8765
DASHBOARD_REMOTE_PORT=8766
